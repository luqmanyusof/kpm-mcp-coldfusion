{
  "info": {
    "name": "Day 2 - murid API (reference)",
    "description": "Tests for reference/api/murid.cfm (day2.md, Topic 5). Set apiKey in the collection Variables tab (Current value only - never commit it). Run top to bottom with the Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8500/kpm-mcp-coldfusion/reference/api/murid.cfm"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "newId",
      "value": ""
    },
    {
      "key": "newNoKp",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 List all",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}",
          "host": [
            "{{baseUrl}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('data is a list', () => pm.expect(pm.response.json().data).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "2 List - Form 4 only",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}?tingkatan=4",
          "host": [
            "{{baseUrl}}"
          ],
          "query": [
            {
              "key": "tingkatan",
              "value": "4"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('all rows are form 4', () => pm.response.json().data.forEach(r => pm.expect(r.tingkatan).to.eql(4)));"
            ]
          }
        }
      ]
    },
    {
      "name": "3 Get one",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}?id=1",
          "host": [
            "{{baseUrl}}"
          ],
          "query": [
            {
              "key": "id",
              "value": "1"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('id is 1', () => pm.expect(pm.response.json().data.id).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "4 Create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}",
          "host": [
            "{{baseUrl}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nama\": \"Chong Ke Xin\",\n  \"no_kp\": \"{{newNoKp}}\",\n  \"jantina\": \"Perempuan\",\n  \"tingkatan\": 2,\n  \"kelas\": \"Amanah\",\n  \"tarikh_lahir\": \"2012-04-09\",\n  \"bangsa\": \"Cina\",\n  \"agama\": \"Buddha\",\n  \"pendapatan_isi_rumah\": 4100,\n  \"bilangan_adik_beradik\": 1\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('newId', pm.response.json().data.id);",
              "pm.test('returns the new record', () => pm.expect(pm.response.json().data.nama).to.eql('Chong Ke Xin'));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// unique IC number each run so the test can be repeated",
              "const n = String(Date.now()).slice(-4);",
              "pm.collectionVariables.set('newNoKp', '120409-10-' + n);"
            ]
          }
        }
      ]
    },
    {
      "name": "5 Update the new record",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}?id={{newId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "query": [
            {
              "key": "id",
              "value": "{{newId}}"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"kelas\": \"Bestari\",\n  \"tingkatan\": 3\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('kelas changed', () => pm.expect(pm.response.json().data.kelas).to.eql('Bestari'));"
            ]
          }
        }
      ]
    },
    {
      "name": "6 Delete the new record",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}?id={{newId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "query": [
            {
              "key": "id",
              "value": "{{newId}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('deleted', () => pm.expect(pm.response.json().deleted).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "7 Reject - wrong key",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}",
          "host": [
            "{{baseUrl}}"
          ]
        },
        "auth": {
          "type": "apikey",
          "apikey": [
            {
              "key": "key",
              "value": "X-API-Key",
              "type": "string"
            },
            {
              "key": "value",
              "value": "wrong-key",
              "type": "string"
            },
            {
              "key": "in",
              "value": "header",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "8 Reject - bad input",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}",
          "host": [
            "{{baseUrl}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nama\": \"Chong Ke Xin\",\n  \"no_kp\": \"123\",\n  \"jantina\": \"Perempuan\",\n  \"tingkatan\": 7,\n  \"kelas\": \"Amanah\",\n  \"tarikh_lahir\": \"2012-04-09\",\n  \"bangsa\": \"Cina\",\n  \"agama\": \"Buddha\",\n  \"pendapatan_isi_rumah\": 4100,\n  \"bilangan_adik_beradik\": 1\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', () => pm.response.to.have.status(400));",
              "pm.test('explains the problem', () => pm.expect(pm.response.json().error).to.include('tingkatan'));"
            ]
          }
        }
      ]
    },
    {
      "name": "9 Reject - not found",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}?id=999999",
          "host": [
            "{{baseUrl}}"
          ],
          "query": [
            {
              "key": "id",
              "value": "999999"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}